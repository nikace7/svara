# Reference only. Run pnpm setup:local to generate fresh local secrets.
APP_ENV=local
APP_ORIGIN=http://localhost:4320
# Server-only route for staff session checks; Compose overrides this to http://api:4100.
API_INTERNAL_ORIGIN=http://127.0.0.1:4100
DATABASE_URL=postgresql://svara:GENERATED_LOCALLY@127.0.0.1:5434/svara_dev
TEST_DATABASE_URL=postgresql://svara:GENERATED_LOCALLY@127.0.0.1:5434/svara_test
POSTGRES_PASSWORD=GENERATED_LOCALLY
REDIS_URL=redis://127.0.0.1:6381
MEDIA_ROOT=SET_TO_ABSOLUTE_LOCAL_MEDIA_DIRECTORY
# Compose uses the Linux sandbox. Native development may explicitly select native.
MEDIA_INSPECTION_MODE=sandboxed
FFPROBE_PATH=ffprobe
MEDIA_SANDBOX_PATH=/usr/local/bin/svara-media-sandbox
AUTH_TOKEN_PEPPER=GENERATED_LOCALLY
PROVIDER_MODE=fixture
# gemini: one free-tier key covers recognition, generation and synthesis.
# azure: Azure Speech F0 recognition/synthesis; requires the two settings below.
SPEECH_PROVIDER=gemini
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GENERATION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional alternative; not required for the free-tier demo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
VOICE_EN=en-US-JennyNeural
VOICE_NE=ne-NP-HemkalaNeural
VOICE_SESSION_SECONDS=300
VOICE_IDLE_SECONDS=60
LIVE_DAILY_SESSIONS=100
LIVE_DAILY_AUDIO_MINUTES=60
TRANSCRIPT_RETENTION_DAYS=30
ALLOW_LIVE_EVAL=false
BIND_HOST=127.0.0.1
# Only the isolated Compose API trusts one gateway hop. Native development trusts none.
TRUST_PROXY_HOPS=0
API_PORT=4100
WORKER_PORT=4101
# Keep the same namespace on the API and worker; isolate separate installations.
WORKER_NAMESPACE=svara
