{
  "name": "@svara/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @svara/audio build && node --import tsx ../../scripts/prepare-audio.ts && next dev --hostname 127.0.0.1 --port 3001",
    "build": "node --import tsx ../../scripts/prepare-audio.ts && next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@svara/audio": "workspace:*",
    "@svara/contracts": "workspace:*",
    "@svara/ui": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "lucide-react": "0.577.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.88.0",
    "socket.io-client": "4.8.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
