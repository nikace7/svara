{
  "name": "@svara/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "concurrently --kill-others --names compile,run \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@svara/config": "workspace:*",
    "@svara/contracts": "workspace:*",
    "@svara/domain": "workspace:*",
    "bullmq": "6.3.4",
    "sharp": "0.35.5"
  }
}
