{
  "name": "@svara/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./authoring-openapi": {
      "types": "./src/authoring-openapi.ts",
      "default": "./dist/authoring-openapi.js"
    },
    "./schedule-openapi": {
      "types": "./src/schedule-openapi.ts",
      "default": "./dist/schedule-openapi.js"
    },
    "./conversation-openapi": {
      "types": "./src/conversation-openapi.ts",
      "default": "./dist/conversation-openapi.js"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
