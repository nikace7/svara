  "info": {
    "title": "Svara API",
    "description": "Staff identity, organisation access and process/dependency health. Mutations require the configured Origin and authenticated mutations also require X-CSRF-Token.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "staff": {
        "type": "apiKey",
        "in": "cookie",
        "name": "svara-session",
        "description": "Host-only staff cookie; __Host-svara-session on HTTPS."
      }
    },
    "schemas": {
      "HealthData": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "ready",
              "unavailable"
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "api"
            ]
          },
          "providerMode": {
            "type": "string",
            "enum": [
              "fixture",
              "live"
            ]
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "ready",
                "unavailable"
              ]
            }
          }
        },
        "required": [
          "status",
          "service",
          "providerMode"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthData"
          }
        },
        "required": [
          "data"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "object",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "organisationName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "email",
          "password",
          "displayName",
          "organisationName"
        ]
      },
      "StaffUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "displayName"
        ]
      },
      "MembershipBriefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMINISTRATOR",
              "OPERATOR",
              "VIEWER"
            ]
          }
        },
        "required": [
          "id",
          "role"
        ]
      },
      "OrganisationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "timezone"
        ]
      },
      "OrganisationBriefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "AvailableMembershipDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMINISTRATOR",
              "OPERATOR",
              "VIEWER"
            ]
          },
          "organisation": {
            "$ref": "#/components/schemas/OrganisationBriefDto"
          }
        },
        "required": [
          "id",
          "role",
          "organisation"
        ]
      },
      "StaffIdentityDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/StaffUserDto"
          },
          "membership": {
            "$ref": "#/components/schemas/MembershipBriefDto"
          },
          "organisation": {
            "$ref": "#/components/schemas/OrganisationDto"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailableMembershipDto"
            }
          }
        },
        "required": [
          "user",
          "membership",
          "organisation",
          "memberships"
        ]
      },
      "StaffSessionData": {
        "type": "object",
        "properties": {
          "identity": {
            "$ref": "#/components/schemas/StaffIdentityDto"
          },
          "csrfToken": {
            "type": "string"
          }
        },
        "required": [
          "identity",
          "csrfToken"
        ]
      },
      "StaffSessionResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/StaffSessionData"
          }
        },
        "required": [
          "data"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CsrfData": {
        "type": "object",
        "properties": {
          "csrfToken": {
            "type": "string"
          }
        },
        "required": [
          "csrfToken"
        ]
      },
      "CsrfResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CsrfData"
          }
        },
        "required": [
          "data"
        ]
      },
      "ResultData": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ]
      },
      "ResultResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ResultData"
          }
        },
        "required": [
          "data"
        ]
      },
      "SwitchOrganisationDto": {
        "type": "object",
        "properties": {
          "organisationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "organisationId"
        ]
      },
      "ActivateDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "writeOnly": true
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "token",
          "password",
          "displayName"
        ]
      },
      "RecoverDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "writeOnly": true
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "StaffMemberDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMINISTRATOR",
              "OPERATOR",
              "VIEWER"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "user": {
            "$ref": "#/components/schemas/StaffUserDto"
          }
        },
        "required": [
          "id",
          "role",
          "enabled",
          "user"
        ]
      },
      "MembersResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StaffMemberDto"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "InviteDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMINISTRATOR",
              "OPERATOR",
              "VIEWER"
            ]
          }
        },
        "required": [
          "email",
          "role"
        ]
      },
      "AccessLinkData": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "One-use activation/recovery link, returned once. Token is in the fragment."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "url",
          "expiresAt"
        ]
      },
      "AccessLinkResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AccessLinkData"
          }
        },
        "required": [
          "data"
        ]
      },
      "MemberUpdateDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMINISTRATOR",
              "OPERATOR",
              "VIEWER"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "role",
          "enabled"
        ]
      },
      "MemberResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/StaffMemberDto"
          }
        },
        "required": [
          "data"
        ]
      },
      "OrganisationUpdateDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "timezone": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "name",
          "timezone"
        ]
      },
      "OrganisationResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/OrganisationDto"
          }
        },
        "required": [
          "data"
        ]
      }
    }
  }
}
