generator client {
  provider = "prisma-client"
  output = "../src/generated"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model ApplicationMetadata {
  id String @id
  schemaVersion Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Organisation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @db.VarChar(160)
  timezone String @default("Asia/Kathmandu") @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  memberships Membership[]
  auditEntries AuditEntry[]
  bots Bot[]
  mediaAssets MediaAsset[]
  devices Device[]
  events Event[]
  dailyUsage DailyUsage[]
}

model Bot {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  name String @db.VarChar(120)
  description String @default("") @db.VarChar(1000)
  revision Int @default(1)
  nextReleaseVersion Int @default(1)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  draft BotDraft?
  knowledge KnowledgeEntry[]
  presentations Presentation[]
  releases BotRelease[]

  @@unique([id, organisationId])
  @@index([organisationId, archivedAt, createdAt])
}

model BotDraft {
  botId String @id @db.Uuid
  organisationId String @db.Uuid
  config Json
  presentationId String? @db.Uuid
  bot Bot @relation(fields: [botId, organisationId], references: [id, organisationId], onDelete: Cascade)
  presentation Presentation? @relation(fields: [presentationId, botId, organisationId], references: [id, botId, organisationId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([botId, organisationId])
  @@index([presentationId, botId, organisationId])
}

model Presentation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  botId String @db.Uuid
  name String @db.VarChar(120)
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  bot Bot @relation(fields: [botId, organisationId], references: [id, organisationId], onDelete: Cascade)
  selectedBy BotDraft[]
  slides Slide[]

  @@unique([id, organisationId])
  @@unique([id, botId, organisationId])
  @@index([organisationId, botId, createdAt])
}

enum SlideTarget {
  PRIMARY
  SECONDARY
  BOTH
}

model Slide {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  presentationId String @db.Uuid
  position Int
  titleEn String @default("") @db.VarChar(160)
  titleNe String @default("") @db.VarChar(160)
  bodyEn String @default("") @db.VarChar(2000)
  bodyNe String @default("") @db.VarChar(2000)
  mediaId String? @db.Uuid
  mediaState MediaState?
  target SlideTarget @default(BOTH)
  durationSeconds Int @default(10)
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  presentation Presentation @relation(fields: [presentationId, organisationId], references: [id, organisationId], onDelete: Cascade)
  media MediaAsset? @relation(fields: [mediaId, organisationId, mediaState], references: [id, organisationId, state], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organisationId])
  @@unique([presentationId, position])
  @@index([organisationId, presentationId])
  @@index([mediaId, organisationId, mediaState])
}

enum KnowledgeType {
  FAQ
  NOTE
}

enum KnowledgeStatus {
  DRAFT
  APPROVED
}

model KnowledgeEntry {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  botId String @db.Uuid
  type KnowledgeType
  title String @db.VarChar(160)
  contentEn String @default("") @db.VarChar(8000)
  contentNe String @default("") @db.VarChar(8000)
  questionEn String @default("") @db.VarChar(500)
  questionNe String @default("") @db.VarChar(500)
  status KnowledgeStatus @default(DRAFT)
  selected Boolean @default(true)
  revision Int @default(1)
  approvedAt DateTime? @db.Timestamptz(3)
  approvedByMembershipId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  bot Bot @relation(fields: [botId, organisationId], references: [id, organisationId], onDelete: Cascade)
  approvedBy Membership? @relation(fields: [approvedByMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@unique([id, organisationId])
  @@index([organisationId, botId, status, createdAt])
  @@index([approvedByMembershipId])
}

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email String @unique @db.VarChar(254)
  displayName String @db.VarChar(160)
  passwordHash String
  disabled Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  memberships Membership[]
}

enum MembershipRole {
  OWNER
  ADMINISTRATOR
  OPERATOR
  VIEWER
}

model Membership {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  userId String @db.Uuid
  role MembershipRole
  enabled Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions StaffSession[]
  issuedGrants StaffGrant[] @relation("GrantIssuer")
  recoveryGrants StaffGrant[] @relation("GrantTarget")
  auditEntries AuditEntry[]

  approvedKnowledge KnowledgeEntry[]
  uploadedMedia MediaAsset[]
  idempotencyRecords IdempotencyRecord[]
  issuedPairings PairingChallenge[]
  createdDeployments Deployment[]
  createdLinks AssistantLink[]
  conversations ConversationSession[]

  @@unique([organisationId, userId])
  @@unique([id, organisationId])
  @@index([userId])
}

model StaffSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  membershipId String @db.Uuid
  organisationId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  membership Membership @relation(fields: [membershipId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@index([membershipId])
  @@index([expiresAt])
}

enum StaffGrantPurpose {
  INVITATION
  RECOVERY
}

model StaffGrant {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  purpose StaffGrantPurpose
  organisationId String @db.Uuid
  issuerMembershipId String @db.Uuid
  targetMembershipId String? @db.Uuid
  email String @db.VarChar(254)
  role MembershipRole?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  issuer Membership @relation("GrantIssuer", fields: [issuerMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict)
  target Membership? @relation("GrantTarget", fields: [targetMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@index([organisationId, email, purpose])
  @@index([expiresAt])
  @@index([issuerMembershipId])
  @@index([targetMembershipId])
}

enum AuditActorKind {
  STAFF
  LOCAL
  SYSTEM
}

enum MediaState {
  UPLOADING
  RECEIVING
  QUARANTINED
  INSPECTING
  READY
  REJECTED
  DELETING
}

model MediaAsset {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  createdByMembershipId String @db.Uuid
  filename String @db.VarChar(160)
  declaredMime String @db.VarChar(32)
  declaredBytes Int
  state MediaState @default(UPLOADING)
  revision Int @default(1)
  uploadedBytes Int @default(0)
  sourceSha256 String? @db.VarChar(64)
  storageKey String? @db.VarChar(80)
  thumbnailKey String? @db.VarChar(80)
  mimeType String? @db.VarChar(32)
  byteLength Int?
  sha256 String? @db.VarChar(64)
  width Int?
  height Int?
  durationSeconds Float?
  thumbnailBytes Int?
  thumbnailSha256 String? @db.VarChar(64)
  rejection String? @db.VarChar(40)
  leaseToken String? @db.Uuid
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  attempts Int @default(0)
  uploadedAt DateTime? @db.Timestamptz(3)
  inspectedAt DateTime? @db.Timestamptz(3)
  cleanedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  createdBy Membership @relation(fields: [createdByMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict)
  slides Slide[]
  releaseMedia ReleaseMedia[]

  @@unique([id, organisationId])
  @@unique([id, organisationId, state])
  @@unique([id, organisationId, state, sha256, byteLength], map: "MediaAsset_release_identity_key")
  @@index([organisationId, createdAt])
  @@index([state, leaseExpiresAt])
  @@index([state, createdAt])
  @@index([createdByMembershipId])
}

enum ReleaseKind {
  PREVIEW
  PUBLISHED
}

model BotRelease {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  botId String @db.Uuid
  kind ReleaseKind
  version Int?
  previewExpiresAt DateTime? @db.Timestamptz(3)
  botRevision Int
  providerMode String @db.VarChar(8)
  snapshot Json
  snapshotHash String @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  bot Bot @relation(fields: [botId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  knowledge ReleaseKnowledge[]
  media ReleaseMedia[]
  idempotencyRecords IdempotencyRecord[]
  deployments Deployment[]
  links AssistantLink[]
  conversations ConversationSession[]

  @@unique([id, organisationId])
  @@unique([id, organisationId, snapshotHash])
  @@unique([botId, version])
  @@index([organisationId, botId, createdAt])
  @@index([kind, previewExpiresAt])
}

model ReleaseKnowledge {
  releaseId String @db.Uuid
  organisationId String @db.Uuid
  snapshotHash String @db.VarChar(64)
  entryId String @db.Uuid
  locale String @db.VarChar(2)
  type KnowledgeType
  title String @db.VarChar(160)
  question String @db.VarChar(500)
  content String @db.VarChar(8000)
  searchText String @default(dbgenerated())
  normalizedQuestion String @default(dbgenerated())
  searchVector Unsupported("tsvector")? @default(dbgenerated())
  release BotRelease @relation(fields: [releaseId, organisationId, snapshotHash], references: [id, organisationId, snapshotHash], onDelete: Cascade, onUpdate: Restrict, map: "ReleaseKnowledge_release_fkey")

  @@id([releaseId, entryId, locale])
  @@index([organisationId, releaseId, locale])
}

model ReleaseMedia {
  releaseId String @db.Uuid
  organisationId String @db.Uuid
  snapshotHash String @db.VarChar(64)
  mediaId String @db.Uuid
  mediaState MediaState @default(READY)
  sha256 String @db.VarChar(64)
  byteLength Int
  release BotRelease @relation(fields: [releaseId, organisationId, snapshotHash], references: [id, organisationId, snapshotHash], onDelete: Cascade, onUpdate: Restrict, map: "ReleaseMedia_release_fkey")
  media MediaAsset @relation(fields: [mediaId, organisationId, mediaState, sha256, byteLength], references: [id, organisationId, state, sha256, byteLength], onDelete: Restrict, onUpdate: Restrict, map: "ReleaseMedia_asset_fkey")

  @@id([releaseId, mediaId])
  @@index([mediaId, organisationId])
}

model IdempotencyRecord {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  actorMembershipId String @db.Uuid
  operation String @db.VarChar(64)
  keyHash String @db.VarChar(64)
  requestHash String @db.VarChar(64)
  releaseId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  actor Membership @relation(fields: [actorMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict, map: "IdempotencyRecord_actor_fkey")
  release BotRelease @relation(fields: [releaseId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict, map: "IdempotencyRecord_release_fkey")

  @@unique([actorMembershipId, operation, keyHash], map: "IdempotencyRecord_actor_operation_key")
  @@index([expiresAt])
  @@index([releaseId, organisationId])
}

model AuditEntry {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  actorMembershipId String? @db.Uuid
  actorKind AuditActorKind @default(STAFF)
  action String @db.VarChar(64)
  targetId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  actor Membership? @relation(fields: [actorMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@index([organisationId, createdAt])
  @@index([actorMembershipId])
}

model Device {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  name String @db.VarChar(120)
  capabilities Json
  enabled Boolean @default(true)
  maintenanceMode Boolean @default(false)
  revision Int @default(1)
  lastSeenAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  challenges PairingChallenge[]
  credentials DeviceCredential[]
  grants DeviceGrant[]
  deployments Deployment[]
  desiredState DesiredDeviceState?
  commands DeviceCommand[]
  conversations ConversationSession[]

  @@unique([id, organisationId])
  @@index([organisationId, id])
}

model PairingChallenge {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId String @db.Uuid
  organisationId String @db.Uuid
  issuerMembershipId String @db.Uuid
  codeHash String @db.VarChar(43)
  attempts Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  redeemedAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  device Device @relation(fields: [deviceId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  issuer Membership @relation(fields: [issuerMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  credential DeviceCredential?

  @@unique([id, deviceId, organisationId], map: "PairingChallenge_scope_key")
  @@index([deviceId, organisationId])
  @@index([expiresAt])
  @@index([issuerMembershipId, organisationId])
}

model DeviceCredential {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId String @db.Uuid
  organisationId String @db.Uuid
  challengeId String @unique @db.Uuid
  tokenHash String @unique @db.VarChar(43)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  device Device @relation(fields: [deviceId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  challenge PairingChallenge @relation(fields: [challengeId, deviceId, organisationId], references: [id, deviceId, organisationId], onDelete: Restrict, onUpdate: Restrict)
  tickets DeviceTicket[]

  @@unique([id, deviceId, organisationId], map: "DeviceCredential_scope_key")
  @@unique([challengeId, deviceId, organisationId], map: "DeviceCredential_challenge_scope_key")
  @@index([deviceId, organisationId, revokedAt])
}

enum DeviceClientRole {
  PRIMARY
  DISPLAY
}

model DeviceTicket {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  credentialId String @db.Uuid
  deviceId String @db.Uuid
  organisationId String @db.Uuid
  tokenHash String @unique @db.VarChar(43)
  namespace String @db.VarChar(16)
  role DeviceClientRole
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  credential DeviceCredential @relation(fields: [credentialId, deviceId, organisationId], references: [id, deviceId, organisationId], onDelete: Restrict, onUpdate: Restrict)
  grant DeviceGrant?

  @@unique([id, credentialId, deviceId, organisationId, role, namespace], map: "DeviceTicket_scope_key")
  @@index([credentialId, role, expiresAt])
  @@index([deviceId, organisationId])
  @@index([expiresAt])
}

model DeviceGrant {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId String @unique @db.Uuid
  credentialId String @db.Uuid
  deviceId String @db.Uuid
  organisationId String @db.Uuid
  namespace String @db.VarChar(16)
  role DeviceClientRole
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  device Device @relation(fields: [deviceId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  ticket DeviceTicket @relation(fields: [ticketId, credentialId, deviceId, organisationId, role, namespace], references: [id, credentialId, deviceId, organisationId, role, namespace], onDelete: Restrict, onUpdate: Restrict)

  @@unique([ticketId, credentialId, deviceId, organisationId, role, namespace], map: "DeviceGrant_ticket_scope_key")
  @@index([deviceId, organisationId, role, expiresAt])
  @@index([expiresAt])
}

/// Descriptive grouping only: deployments own their actual times.
model Event {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  name String @db.VarChar(120)
  venue String @default("") @db.VarChar(160)
  timezone String @db.VarChar(64)
  suggestedStartsAt DateTime? @db.Timestamptz(3)
  suggestedEndsAt DateTime? @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deployments Deployment[]

  @@unique([id, organisationId])
  @@index([organisationId, archivedAt, name])
}
enum DeploymentKind {
  SCHEDULED
  OVERRIDE
}
/// Intervals are [startsAt, endsAt). Overlap checks run under the device row lock.
model Deployment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  deviceId String @db.Uuid
  releaseId String @db.Uuid
  eventId String? @db.Uuid
  kind DeploymentKind
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)
  revision Int @default(1)
  createdByMembershipId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  device Device @relation(fields: [deviceId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  release BotRelease @relation(fields: [releaseId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  event Event? @relation(fields: [eventId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  createdBy Membership @relation(fields: [createdByMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  desiredStates DesiredDeviceState[]

  @@unique([id, organisationId])
  @@index([deviceId, organisationId, kind, endsAt])
  @@index([organisationId, startsAt])
  @@index([releaseId, organisationId])
  @@index([eventId, organisationId])
  @@index([createdByMembershipId, organisationId])
}
/// One row per device. revision only moves forward; applied* is what the device acknowledged.
model DesiredDeviceState {
  deviceId String @id @db.Uuid
  organisationId String @db.Uuid
  revision Int
  releaseId String? @db.Uuid
  deploymentId String? @db.Uuid
  appliedRevision Int @default(0)
  appliedReleaseId String? @db.Uuid
  appliedAt DateTime? @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)
  device Device @relation(fields: [deviceId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  deployment Deployment? @relation(fields: [deploymentId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([deviceId, organisationId])
  @@index([deploymentId, organisationId])
}
enum DeviceCommandStatus {
  QUEUED
  SENT
  ACKNOWLEDGED
  FAILED
  EXPIRED
  SUPERSEDED
}
/// The durable outbox: written in the same transaction as the desired-state change it carries.
model DeviceCommand {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  deviceId String @db.Uuid
  type String @db.VarChar(32)
  payload Json
  stateRevision Int
  status DeviceCommandStatus @default(QUEUED)
  attempts Int @default(0)
  nextAttemptAt DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  sentAt DateTime? @db.Timestamptz(3)
  acknowledgedAt DateTime? @db.Timestamptz(3)
  result String? @db.VarChar(16)
  reason String? @db.VarChar(64)
  device Device @relation(fields: [deviceId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  tool ToolExecution?

  @@index([status, nextAttemptAt])
  @@index([deviceId, organisationId, createdAt])
}

/// A pinned, revocable public entry point. Disabling it ends its sessions in the same transaction.
model AssistantLink {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  slug String @unique @db.VarChar(32)
  releaseId String @db.Uuid
  label String @default("") @db.VarChar(120)
  enabled Boolean @default(true)
  expiresAt DateTime? @db.Timestamptz(3)
  revision Int @default(1)
  createdByMembershipId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  release BotRelease @relation(fields: [releaseId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  createdBy Membership @relation(fields: [createdByMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  grants VisitorGrant[]
  sessions ConversationSession[]

  @@unique([id, organisationId])
  @@index([organisationId, createdAt])
  @@index([releaseId, organisationId])
  @@index([createdByMembershipId, organisationId])
}

/// A short-lived HttpOnly visitor cookie bound to one link. Only its hash is stored.
model VisitorGrant {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  linkId String @db.Uuid
  tokenHash String @unique @db.VarChar(43)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  sessionCount Int @default(0)
  turnCount Int @default(0)
  link AssistantLink @relation(fields: [linkId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  sessions ConversationSession[]

  @@unique([id, organisationId])
  @@index([linkId, organisationId])
  @@index([expiresAt])
}

enum ConversationActor {
  STAFF
  DEVICE
  VISITOR
}

enum ConversationStatus {
  ACTIVE
  ENDED
}

enum TurnState {
  ANSWERING
  COMPLETED
  INTERRUPTED
  FAILED
}

enum TurnInput {
  TEXT
  VOICE
}

/// One admitted conversation, pinned to a release. A CHECK constraint ties actorKind to exactly
/// its actor columns. Active means ACTIVE and before both idleUntil and endsBy.
model ConversationSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  releaseId String @db.Uuid
  actorKind ConversationActor
  membershipId String? @db.Uuid
  deviceId String? @db.Uuid
  linkId String? @db.Uuid
  grantId String? @db.Uuid
  resumedFromId String? @db.Uuid
  locale String @db.VarChar(8)
  providerMode String @db.VarChar(8)
  status ConversationStatus @default(ACTIVE)
  generation Int @default(0)
  startedAt DateTime @db.Timestamptz(3)
  idleUntil DateTime @db.Timestamptz(3)
  endsBy DateTime @db.Timestamptz(3)
  endedAt DateTime? @db.Timestamptz(3)
  endReason String? @db.VarChar(32)
  reservedSeconds Int @default(0)
  settledSeconds Int?
  transcriptDeletedAt DateTime? @db.Timestamptz(3)
  release BotRelease @relation(fields: [releaseId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  member Membership? @relation(fields: [membershipId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  device Device? @relation(fields: [deviceId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  link AssistantLink? @relation(fields: [linkId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  grant VisitorGrant? @relation(fields: [grantId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  turns ConversationTurn[]

  @@unique([id, organisationId])
  @@index([organisationId, startedAt])
  @@index([organisationId, status])
  @@index([status, idleUntil])
  @@index([releaseId, organisationId])
  @@index([membershipId, organisationId])
  @@index([deviceId, organisationId, startedAt])
  @@index([linkId, organisationId])
  @@index([grantId, organisationId])
}

/// Persisted incrementally: created when the question arrives, then completed, INTERRUPTED or
/// FAILED when its answer stops. Deleting a transcript blanks text, never the row.
model ConversationTurn {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  sessionId String @db.Uuid
  ordinal Int
  generation Int
  clientMessageId String @db.Uuid
  retryOfId String? @db.Uuid
  inputKind TurnInput
  locale String @db.VarChar(8)
  transcript String @db.VarChar(2000)
  answer String @default("") @db.VarChar(8000)
  citedEntryIds String[] @default([]) @db.Uuid
  state TurnState @default(ANSWERING)
  failureCode String? @db.VarChar(32)
  sttMs Int?
  firstTextMs Int?
  firstAudioMs Int?
  totalMs Int?
  createdAt DateTime @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  session ConversationSession @relation(fields: [sessionId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  tools ToolExecution[]

  @@unique([sessionId, ordinal])
  @@unique([sessionId, clientMessageId])
  @@unique([id, sessionId, organisationId])
  @@index([organisationId, createdAt])
}

/// A validated tool call. The model never supplies organisation, session or device identity.
model ToolExecution {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  sessionId String @db.Uuid
  turnId String @db.Uuid
  callId String @db.VarChar(64)
  name String @db.VarChar(32)
  arguments Json?
  status String @db.VarChar(16)
  reason String? @db.VarChar(64)
  result Json?
  commandId String? @unique @db.Uuid
  createdAt DateTime @db.Timestamptz(3)
  turn ConversationTurn @relation(fields: [turnId, sessionId, organisationId], references: [id, sessionId, organisationId], onDelete: Restrict, onUpdate: Restrict)
  command DeviceCommand? @relation(fields: [commandId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@unique([turnId, callId])
  @@index([sessionId, organisationId])
}

/// Live admission accounting per organisation and UTC day; locked on every admission.
model DailyUsage {
  organisationId String @db.Uuid
  usageDate DateTime @db.Date
  liveSessions Int @default(0)
  reservedSeconds Int @default(0)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([organisationId, usageDate])
}
