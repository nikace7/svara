generator client {
  provider = "prisma-client"
  output = "../src/generated"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model ApplicationMetadata {
  id String @id
  schemaVersion Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Organisation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @db.VarChar(160)
  timezone String @default("Asia/Kathmandu") @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  memberships Membership[]
  auditEntries AuditEntry[]
  bots Bot[]
  mediaAssets MediaAsset[]
}

model Bot {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  name String @db.VarChar(120)
  description String @default("") @db.VarChar(1000)
  revision Int @default(1)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  draft BotDraft?
  knowledge KnowledgeEntry[]

  @@unique([id, organisationId])
  @@index([organisationId, archivedAt, createdAt])
}

model BotDraft {
  botId String @id @db.Uuid
  organisationId String @db.Uuid
  config Json
  bot Bot @relation(fields: [botId, organisationId], references: [id, organisationId], onDelete: Cascade)

  @@unique([botId, organisationId])
}

enum KnowledgeType {
  FAQ
  NOTE
}

enum KnowledgeStatus {
  DRAFT
  APPROVED
}

model KnowledgeEntry {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  botId String @db.Uuid
  type KnowledgeType
  title String @db.VarChar(160)
  contentEn String @default("") @db.VarChar(8000)
  contentNe String @default("") @db.VarChar(8000)
  questionEn String @default("") @db.VarChar(500)
  questionNe String @default("") @db.VarChar(500)
  status KnowledgeStatus @default(DRAFT)
  selected Boolean @default(true)
  revision Int @default(1)
  approvedAt DateTime? @db.Timestamptz(3)
  approvedByMembershipId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  bot Bot @relation(fields: [botId, organisationId], references: [id, organisationId], onDelete: Cascade)
  approvedBy Membership? @relation(fields: [approvedByMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@unique([id, organisationId])
  @@index([organisationId, botId, status, createdAt])
  @@index([approvedByMembershipId])
}

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email String @unique @db.VarChar(254)
  displayName String @db.VarChar(160)
  passwordHash String
  disabled Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  memberships Membership[]
}

enum MembershipRole {
  OWNER
  ADMINISTRATOR
  OPERATOR
  VIEWER
}

model Membership {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  userId String @db.Uuid
  role MembershipRole
  enabled Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions StaffSession[]
  issuedGrants StaffGrant[] @relation("GrantIssuer")
  recoveryGrants StaffGrant[] @relation("GrantTarget")
  auditEntries AuditEntry[]

  approvedKnowledge KnowledgeEntry[]
  uploadedMedia MediaAsset[]

  @@unique([organisationId, userId])
  @@unique([id, organisationId])
  @@index([userId])
}

model StaffSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  membershipId String @db.Uuid
  organisationId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  membership Membership @relation(fields: [membershipId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@index([membershipId])
  @@index([expiresAt])
}

enum StaffGrantPurpose {
  INVITATION
  RECOVERY
}

model StaffGrant {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  purpose StaffGrantPurpose
  organisationId String @db.Uuid
  issuerMembershipId String @db.Uuid
  targetMembershipId String? @db.Uuid
  email String @db.VarChar(254)
  role MembershipRole?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  issuer Membership @relation("GrantIssuer", fields: [issuerMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict)
  target Membership? @relation("GrantTarget", fields: [targetMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@index([organisationId, email, purpose])
  @@index([expiresAt])
  @@index([issuerMembershipId])
  @@index([targetMembershipId])
}

enum AuditActorKind {
  STAFF
  LOCAL
  SYSTEM
}

enum MediaState {
  UPLOADING
  RECEIVING
  QUARANTINED
  INSPECTING
  READY
  REJECTED
  DELETING
}

model MediaAsset {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  createdByMembershipId String @db.Uuid
  filename String @db.VarChar(160)
  declaredMime String @db.VarChar(32)
  declaredBytes Int
  state MediaState @default(UPLOADING)
  revision Int @default(1)
  uploadedBytes Int @default(0)
  sourceSha256 String? @db.VarChar(64)
  storageKey String? @db.VarChar(80)
  thumbnailKey String? @db.VarChar(80)
  mimeType String? @db.VarChar(32)
  byteLength Int?
  sha256 String? @db.VarChar(64)
  width Int?
  height Int?
  durationSeconds Float?
  thumbnailBytes Int?
  thumbnailSha256 String? @db.VarChar(64)
  rejection String? @db.VarChar(40)
  leaseToken String? @db.Uuid
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  attempts Int @default(0)
  uploadedAt DateTime? @db.Timestamptz(3)
  inspectedAt DateTime? @db.Timestamptz(3)
  cleanedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  createdBy Membership @relation(fields: [createdByMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@unique([id, organisationId])
  @@index([organisationId, createdAt])
  @@index([state, leaseExpiresAt])
  @@index([state, createdAt])
  @@index([createdByMembershipId])
}

model AuditEntry {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String @db.Uuid
  actorMembershipId String? @db.Uuid
  actorKind AuditActorKind @default(STAFF)
  action String @db.VarChar(64)
  targetId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  actor Membership? @relation(fields: [actorMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@index([organisationId, createdAt])
  @@index([actorMembershipId])
}
